generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model categories {
  category_id   Int        @id @default(autoincrement())
  category_name String     @unique @db.VarChar(100)
  description   String?
  products      products[]
}

model products {
  product_id          Int                   @id @default(autoincrement())
  product_name        String                @db.VarChar(255)
  base_product_name   String?               @db.VarChar(255)
  variant_name        String?               @db.VarChar(100)
  quantity_value      Decimal?              @db.Decimal(10, 3)
  quantity_unit       String?               @db.VarChar(20)
  package_size        String?               @db.VarChar(50)
  brand               String?               @db.VarChar(100)
  category_id         Int?
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  categories          categories?           @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  shopping_list_items shopping_list_items[]
  vendor_listings     vendor_listings[]

  @@unique([product_name, brand], map: "unique_product_brand")
}

model shopping_list_items {
  item_id        Int             @id @default(autoincrement())
  list_id        Int?
  product_id     Int?
  quantity       Int?            @default(1)
  shopping_lists shopping_lists? @relation(fields: [list_id], references: [list_id], onDelete: NoAction, onUpdate: NoAction)
  products       products?       @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)
}

model shopping_lists {
  list_id             Int                   @id @default(autoincrement())
  user_id             Int?
  list_name           String                @db.VarChar(100)
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  shopping_list_items shopping_list_items[]
  users               users?                @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  user_id         Int               @id @default(autoincrement())
  email           String            @unique @db.VarChar(255)
  name            String            @db.VarChar(100)
  password_hash   String            @db.VarChar(255)
  user_type       String?           @db.VarChar(20)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  shopping_lists  shopping_lists[]
  vendors         vendors?
  password_resets password_resets[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vendor_listings {
  listing_id     Int       @id @default(autoincrement())
  product_id     Int?
  vendor_id      Int?
  price          Decimal   @db.Decimal(10, 2)
  stock_quantity Int?      @default(0)
  is_available   Boolean?  @default(true)
  last_updated   DateTime? @default(now()) @db.Timestamp(6)
  products       products? @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)
  vendors        vendors?  @relation(fields: [vendor_id], references: [vendor_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([product_id, vendor_id], map: "unique_product_vendor")
  @@unique([product_id, vendor_id])
}

model vendors {
  vendor_id       Int               @id @default(autoincrement())
  user_id         Int?              @unique
  vendor_name     String            @db.VarChar(100)
  contact_email   String?           @db.VarChar(255)
  is_verified     Boolean?          @default(true)
  is_approved     Boolean?          @default(false)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  vendor_listings vendor_listings[]
  users           users?            @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model vendor_uploads {
  upload_id     Int       @id @default(autoincrement())
  vendor_id     Int
  file_name     String    @db.VarChar(255)
  file_url      String?   @db.VarChar(500)
  status        String    @default("pending") @db.VarChar(20)
  uploaded_at   DateTime  @default(now()) @db.Timestamp(6)
  processed_at  DateTime? @db.Timestamp(6)
  error_message String?   @db.Text
}

model password_resets {
  reset_id   Int      @id @default(autoincrement())
  user_id    Int
  token      String   @unique @db.VarChar(255)
  expires_at DateTime @db.Timestamp(6)
  used       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

