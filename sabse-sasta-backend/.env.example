# Backend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# Database Configuration
# For development, use local PostgreSQL:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/sabse_sasta
# For production, use managed database service like Supabase, Railway, etc.
DATABASE_URL=postgresql://user:password@localhost:5432/sabse_sasta

# JWT Configuration
# Generate a strong random key for production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Google OAuth
# Get these from Google Cloud Console (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:5173

# Email Configuration
# Using Gmail: Enable 2FA and create an app-specific password
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=Sabse Sasta
